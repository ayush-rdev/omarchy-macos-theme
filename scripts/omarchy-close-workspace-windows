#!/usr/bin/env python3
import json
import subprocess
import time

try:
    active_ws = json.loads(subprocess.check_output(["hyprctl", "activeworkspace", "-j"], text=True))
    cur_ws_id = active_ws.get("id")
    clients = json.loads(subprocess.check_output(["hyprctl", "clients", "-j"], text=True))
except Exception:
    exit(0)

# Filter windows on the current workspace
ws_windows = [c.get("address") for c in clients if c.get("workspace", {}).get("id") == cur_ws_id and c.get("address")]

for addr in ws_windows:
    subprocess.run(["hyprctl", "dispatch", f'hl.dsp.window.close({{ window = "address:{addr}" }})'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
